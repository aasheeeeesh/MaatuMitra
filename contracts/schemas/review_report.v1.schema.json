{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maatumitra:contract:review_report.v1",
  "title": "review_report.v1",
  "description": "Machine-readable report of one SIMULATED (AI) review. label is always 'ai_simulated_review'; it is never native-speaker or clinical validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "reviewer_agent", "target", "date", "sample_size", "findings", "summary", "label"],
  "properties": {
    "schema_version": {"const": "review_report.v1"},
    "review_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$", "maxLength": 200},
    "reviewer_agent": {"enum": ["kannada-language-reviewer", "clinical-reviewer", "scientific-integrity-auditor", "security-auditor", "integration-qa"]},
    "target": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sample_size": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "item", "problem", "suggested_fix", "evidence", "source_urls", "confidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "major", "minor"]},
          "item": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 1},
          "suggested_fix": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "source_urls": {"type": "array", "items": {"type": "string", "pattern": "^https?://\\S+$"}},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "label": {"const": "ai_simulated_review"}
  }
}
