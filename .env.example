# Copy to .env (git-ignored) and replace every value with a LOCAL sandbox value.
# Never commit .env. Never put real credentials anywhere in this repo.
# Generate secrets with: uv run python -c "import secrets; print(secrets.token_hex(32))"

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=maatumitra
# With Docker these two create the image's BOOTSTRAP SUPERUSER. Never use owner_role here (F7).
# Set PG_BOOTSTRAP_USER / PG_BOOTSTRAP_PASSWORD (below) to the SAME values.
POSTGRES_USER=mm_bootstrap
POSTGRES_PASSWORD=REPLACE_ME_LOCAL_ONLY
# Password of the migration/owner login owner_role. Must differ from the bootstrap password.
OWNER_DB_PASSWORD=REPLACE_ME_LOCAL_ONLY
API_DB_USER=api_login
API_DB_PASSWORD=REPLACE_ME_LOCAL_ONLY

JWT_SIGNING_KEY=REPLACE_ME_RANDOM_HEX
JWT_ISSUER=maatumitra-mock-issuer
JWT_AUDIENCE=maatumitra-api
RESEARCH_PSEUDONYM_HMAC_KEY=REPLACE_ME_RANDOM_HEX

API_HOST=127.0.0.1
API_PORT=8000
UI_HOST=127.0.0.1
UI_PORT=8501
MODE=mock

# --- m5_backend (added 2026-11-09; placeholders only) ---
# Bootstrap superuser: ONLY creates roles + databases (db_up.sh, test fixture). Never used by
# requests. With Docker, POSTGRES_USER/POSTGRES_PASSWORD above create the image superuser:
# set them to the same values as these two (see m5_backend/README.md).
PG_BOOTSTRAP_USER=mm_bootstrap
PG_BOOTSTRAP_PASSWORD=REPLACE_ME_LOCAL_ONLY
# Local non-Docker Postgres 16 (m5_backend/scripts/db_up.sh). Paths are OUTSIDE the repo.
PG_BIN=REPLACE_ME_PATH_TO_POSTGRES_16_BIN
PGDATA_DIR=REPLACE_ME_PATH_OUTSIDE_REPO
JWT_TTL_SECONDS=300
MOCK_LOGIN_PASSWORD=REPLACE_ME_RANDOM_HEX
M5_AUDIO_DIR=REPLACE_ME_PATH_OUTSIDE_REPO
# Transcripts for GET /records/{id}/transcript: dir/ENCOUNTER_UUID.json (default: M5_AUDIO_DIR/transcripts)
M5_TRANSCRIPT_DIR=
# Optional verifier plug-in by import path (package.module:function). Empty = flag everything.
MAATUMITRA_VERIFIER=
